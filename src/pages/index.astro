---
import { ArrowRight, Brain, FolderSearch, MessageSquareMore, ScrollText, Wrench } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionCard from '../components/CollectionCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { buildSitePath } from '../lib/site';
import { researchWorkflow } from '../data/research-workflow';

const base = import.meta.env.BASE_URL;
const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const toolTitles = new Map(tools.map((tool) => [tool.id, tool.data.title]));
const featuredTools = ['notebooklm', 'codex', 'claude-code', 'git-github', 'skill', 'subagent']
  .map((id) => tools.find((tool) => tool.id === id))
  .filter(Boolean);
---

<BaseLayout>
  <section class="home-intro agent-intro">
    <div class="home-intro-inner">
      <div class="intro-copy">
        <p class="eyebrow">AI AGENT FIELD GUIDE</p>
        <h1>研究生 AI 研究工作台</h1>
        <p class="intro-lead">這裡可以找適合研究工作的 AI 技能</p>
        <p class="intro-note">讀論文、修改文章、做簡報，或把進度交給下一次對話：先找一項現在用得上的技能，展開介紹就能看到怎麼開始。</p>
        <div class="entry-actions" aria-label="選擇開始方式">
          <a class="entry-link primary-entry" href={buildSitePath(base, '/learn/')}><MessageSquareMore aria-hidden="true" /><span><strong>第一次用 Agent</strong><small>從 Chat 與 Agent 的差別開始</small></span><ArrowRight aria-hidden="true" /></a>
          <a class="entry-link" href={buildSitePath(base, '/tools/')}><Wrench aria-hidden="true" /><span><strong>查工具名詞</strong><small>NotebookLM、Codex、Skill 到 MCP</small></span><ArrowRight aria-hidden="true" /></a>
          <a class="entry-link" href={buildSitePath(base, '/guides/research-skills/')}><FolderSearch aria-hidden="true" /><span><strong>找研究技能</strong><small>搜尋用途、名稱，再展開看用法</small></span><ArrowRight aria-hidden="true" /></a>
        </div>
        <SearchBox destination="/guides/research-skills/" label="搜尋研究技能" placeholder="試試：論文、簡報、交接、NotebookLM…" />
        <p class="intro-note">想省 token 與模型費用？<a href={`${buildSitePath(base, '/learn/03-context-and-indexes/')}#model-delegation`}>學會拆解工作、分配算力與模型分工</a>，用清楚的交接減少重做。</p>
      </div>
      <div class="agent-loop" aria-label="Agent 由腦、手、規矩與驗證迴圈組成">
        <div class="loop-title">會做事的助手</div>
        <div class="loop-parts">
          <div><Brain aria-hidden="true" /><strong>腦</strong><span>模型負責理解與判斷</span></div>
          <div><Wrench aria-hidden="true" /><strong>手</strong><span>工具負責讀檔與動手</span></div>
          <div><ScrollText aria-hidden="true" /><strong>規矩</strong><span>你決定界線與習慣</span></div>
        </div>
        <div class="loop-cycle"><span>觀察</span><ArrowRight aria-hidden="true" /><span>動手</span><ArrowRight aria-hidden="true" /><span>驗證</span><ArrowRight aria-hidden="true" /><span>再調整</span></div>
      </div>
    </div>
  </section>

  <section class="page-band workflow-preview" aria-labelledby="workflow-start-title">
    <div class="section-heading split-heading">
      <div><span class="section-kicker">從手上的研究工作開始</span><h2 id="workflow-start-title">依研究階段開始</h2><p>先找目前要做的事，再看 AI 能協助什麼、自己要查核什麼。</p></div>
      <a class="text-link" href={buildSitePath(base, '/guides/research-workflow/')}>查看研究流程導讀 <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <ol class="workflow-starts">
      {researchWorkflow.map((stage, index) => <li><a href={`${buildSitePath(base, '/guides/research-workflow/')}#${stage.id}`}><span class="section-kicker">{String(index + 1).padStart(2, '0')}</span><strong>{stage.title}</strong><p>{stage.summary}</p><ArrowRight size={18} aria-hidden="true" /></a></li>)}
    </ol>
  </section>

  <section class="page-band learning-preview">
    <div class="section-heading split-heading">
      <div><span class="section-kicker">核心學習路徑</span><h2>先學會怎麼合作，再決定用哪個工具</h2><p>從準備研究室會議開始，練習交辦、找資料、檢查成果，再把進度交接給下一次對話。</p></div>
      <a class="text-link" href={buildSitePath(base, '/learn/')}>查看完整路徑 <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <ol class="learning-rail journey-rail">
      {lessons.map((lesson, index) => (
        <li>
          <a href={buildSitePath(base, `/learn/${lesson.id}/`)}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{lesson.data.title}</strong>
            <small>{lesson.data.part} · {lesson.data.estimatedMinutes} 分鐘</small>
            <p>{lesson.data.learningOutcomes[0]}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-band tool-preview">
    <div class="section-heading split-heading">
      <div><span class="section-kicker">概念與工具名稱</span><h2>聽過名字，還要知道它能不能替你動手</h2></div>
      <a class="text-link" href={buildSitePath(base, '/tools/')}>打開工具詞典 <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <div class="tool-chip-grid">
      {featuredTools.map((tool) => tool && <a href={buildSitePath(base, `/tools/${tool.id}/`)}><span>{tool.data.kind}</span><strong>{tool.data.title}</strong><small>{tool.data.summary}</small></a>)}
    </div>
    <p><a class="text-link" href={buildSitePath(base, '/guides/research-skills/')}>研究技能選用指南：從 grill-me 規劃到論文、圖表與簡報 <ArrowRight size={17} aria-hidden="true" /></a></p>
  </section>

  <section class="page-band case-preview">
    <div class="section-heading split-heading">
      <div><span class="section-kicker">真實成果</span><h2>先看做出了什麼，再把做法搬進研究</h2></div>
      <a class="text-link" href={buildSitePath(base, '/cases/')}>查看全部案例 <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <div class="card-grid three">
      {cases.map((item) => <CollectionCard href={buildSitePath(base, `/cases/${item.id}/`)} eyebrow={`${item.data.category} · ${item.data.reproducible ? '可重跑' : '流程紀錄'}`} title={item.data.title} summary={item.data.summary} tags={item.data.relatedTools.slice(0, 3).map((tool) => toolTitles.get(tool) ?? tool)} />)}
    </div>
  </section>

  <section class="closing-band practical-closing">
    <div><span class="section-kicker">第一個習慣</span><h2>把要做的事說清楚，從一個小任務開始。</h2></div>
    <a class="button light" href={buildSitePath(base, '/templates/ask-before-action/')}>直接拿走這段 prompt <ArrowRight size={18} aria-hidden="true" /></a>
  </section>
</BaseLayout>

<style>
  .workflow-starts { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; list-style: none; margin: 0; padding: 0; }
  .workflow-starts li { min-width: 0; }
  .workflow-starts a { display: flex; flex-direction: column; align-items: flex-start; height: 100%; padding: 20px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); text-decoration: none; }
  .workflow-starts strong { margin: 14px 0 8px; font-size: 1.06rem; }
  .workflow-starts p { margin: 0 0 18px; color: var(--muted); font-size: .92rem; text-wrap: pretty; }
  .workflow-starts svg { margin-top: auto; color: var(--teal-dark); }
  .workflow-starts a:hover { border-color: var(--teal); background: var(--surface-soft); }
  @media (max-width: 1000px) { .workflow-starts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .workflow-starts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .workflow-starts { grid-template-columns: 1fr; } }
</style>
