---
import { ArrowRight, BadgeCheck, Blocks, FolderTree, Library, Presentation, RefreshCw } from 'lucide-astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import CollectionCard from '../components/CollectionCard.astro';
import { researchTasks } from '../data/researchTasks';
import { buildSitePath } from '../lib/site';

const base = import.meta.env.BASE_URL;
const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const icons = { library: Library, 'badge-check': BadgeCheck, 'folder-tree': FolderTree, 'refresh-cw': RefreshCw, presentation: Presentation, blocks: Blocks };
---

<BaseLayout>
  <section class="home-intro">
    <div class="home-intro-inner">
      <div class="intro-copy">
        <p class="eyebrow">FOR GRADUATE RESEARCHERS</p>
        <h1>研究生 AI 研究工作台</h1>
        <p class="intro-lead">從問題、證據到可重現產出。先學會界定任務與驗證結果，再選擇適合的 AI 工具。</p>
        <SearchBox />
        <div class="intro-actions">
          <a class="button primary" href={buildSitePath(base, '/learn/')}>開始學習 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="text-link" href={buildSitePath(base, '/templates/')}>直接找研究模板</a>
        </div>
      </div>
      <div class="workflow-visual" aria-label="研究工作流程：問題、證據、執行、驗證">
        <div class="workflow-label">RESEARCH LOOP</div>
        <ol>
          <li><span>01</span><strong>定義問題</strong><small>目標與驗收</small></li>
          <li><span>02</span><strong>整理證據</strong><small>來源可回查</small></li>
          <li><span>03</span><strong>執行產出</strong><small>保留過程</small></li>
          <li><span>04</span><strong>獨立驗證</strong><small>反例與人工判斷</small></li>
        </ol>
        <div class="workflow-proof"><BadgeCheck size={18} aria-hidden="true" />完成不是「AI 說好了」，而是留下可檢查的證據。</div>
      </div>
    </div>
  </section>

  <section class="page-band task-band" id="tasks">
    <div class="section-heading">
      <span class="section-kicker">依研究任務開始</span>
      <h2>你現在要完成什麼？</h2>
      <p>不必先記工具名稱。從眼前的研究工作進入，再補需要的技能。</p>
    </div>
    <div class="task-grid">
      {researchTasks.map((task) => {
        const Icon = icons[task.icon];
        return (
          <a class="task-card" href={`${buildSitePath(base, '/tasks/')}#${task.id}`}>
            <Icon size={22} aria-hidden="true" />
            <div><strong>{task.label}</strong><p>{task.description}</p></div>
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        );
      })}
    </div>
  </section>

  <section class="page-band learning-preview">
    <div class="section-heading split-heading">
      <div><span class="section-kicker">循序能力路徑</span><h2>先建立判斷，再增加自動化</h2></div>
      <a class="text-link" href={buildSitePath(base, '/learn/')}>查看全部 7 個單元 <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <div class="learning-rail">
      {lessons.slice(0, 4).map((lesson, index) => (
        <a href={buildSitePath(base, `/learn/${lesson.id}/`)}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{lesson.data.title}</strong>
          <small>{lesson.data.estimatedMinutes ?? 25} 分鐘 · {lesson.data.difficulty}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="page-band case-preview">
    <div class="section-heading split-heading">
      <div><span class="section-kicker">從真實成果反推方法</span><h2>案例不是展示，是可拆解的證據</h2></div>
      <a class="text-link" href={buildSitePath(base, '/cases/')}>查看六個案例 <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <div class="card-grid three">
      {cases.map((item) => <CollectionCard href={buildSitePath(base, `/cases/${item.id}/`)} eyebrow={item.data.stage} title={item.data.title} summary={item.data.summary} tags={item.data.skills} />)}
    </div>
  </section>

  <section class="closing-band">
    <div><span class="section-kicker">研究底線</span><h2>任何 AI 產出，都要能回到來源與驗證。</h2></div>
    <a class="button light" href={buildSitePath(base, '/safety/')}>查看安全與倫理原則 <ArrowRight size={18} aria-hidden="true" /></a>
  </section>
</BaseLayout>
