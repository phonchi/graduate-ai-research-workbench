---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, Check, Copy, Download } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSitePath } from '../../lib/site';
export async function getStaticPaths() { const entries = await getCollection('templates', ({ data }) => !data.draft); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry); const base = import.meta.env.BASE_URL; const filename = `${entry.id}.md`;
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><div class="template-layout"><article class="single-article" data-pagefind-body><a class="back-link" href={buildSitePath(base, '/templates/')}><ArrowLeft size={16} />直接拿來用</a><header class="article-header"><span class="section-kicker">{entry.data.category} · 投影片 {entry.data.slideRefs.join('、')}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1><p>{entry.data.summary}</p></header><div class="prose"><Content /></div></article><aside class="template-panel"><div class="template-toolbar"><strong>可複製文字</strong><div><button type="button" class="icon-button" title="複製模板" aria-label="複製模板" data-copy-template><Copy size={18} /><Check class="copy-success" size={18} /></button><button type="button" class="icon-button" title="下載 Markdown" aria-label="下載 Markdown" data-download-template data-filename={filename}><Download size={18} /></button></div></div><pre tabindex="0"><code data-template-body>{entry.data.templateBody}</code></pre><p class="copy-status" aria-live="polite" data-copy-status></p></aside></div><script>document.querySelectorAll<HTMLElement>('.template-panel').forEach((panel) => { const body = panel.querySelector<HTMLElement>('[data-template-body]')?.innerText ?? ''; const status = panel.querySelector<HTMLElement>('[data-copy-status]'); panel.querySelector('[data-copy-template]')?.addEventListener('click', async () => { await navigator.clipboard.writeText(body); panel.toggleAttribute('data-copied', true); if (status) status.textContent = '已複製模板'; window.setTimeout(() => panel.removeAttribute('data-copied'), 1500); }); panel.querySelector<HTMLElement>('[data-download-template]')?.addEventListener('click', (event) => { const button = event.currentTarget as HTMLElement; const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([body], { type: 'text/markdown;charset=utf-8' })); link.download = button.dataset.filename ?? 'template.md'; link.click(); URL.revokeObjectURL(link.href); }); });</script></BaseLayout>
