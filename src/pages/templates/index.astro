---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('templates', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="研究模板"><header class="page-header"><div><span class="section-kicker">READY-TO-USE TEMPLATES</span><h1>把好方法帶回你的研究</h1><p>模板不是萬用答案；它把必要背景、證據與驗收欄位先留出來，避免研究交辦只剩一句願望。</p></div></header><section class="page-band"><div class="card-grid three">{items.map((item) => <CollectionCard href={buildSitePath(base, `/templates/${item.id}/`)} eyebrow={item.data.category} title={item.data.title} summary={item.data.summary} tags={item.data.skills} />)}</div></section></BaseLayout>
