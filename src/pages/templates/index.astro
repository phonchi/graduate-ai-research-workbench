---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('templates', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="直接拿來用"><header class="page-header"><div><span class="section-kicker">COPY, TRY, ADJUST</span><h1>不用從空白 prompt 開始</h1><p>七份短模板對應研究中會反覆出現的交辦、索引、規矩、存檔、挑錯與回顧需求。</p></div></header><section class="page-band"><h2 class="sr-only">七份可直接使用的模板</h2><div class="card-grid three">{items.map((item) => <CollectionCard href={buildSitePath(base, `/templates/${item.id}/`)} eyebrow={item.data.category} title={item.data.title} summary={item.data.summary} />)}</div></section></BaseLayout>
