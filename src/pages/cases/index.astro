---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="案例"><header class="page-header"><div><span class="section-kicker">EVIDENCE IN PRACTICE</span><h1>從成果拆解研究工作流</h1><p>每個案例都標出輸入、人工檢查點、驗證證據與不能省略的邊界。</p></div></header><section class="page-band"><div class="card-grid three">{items.map((item) => <CollectionCard href={buildSitePath(base, `/cases/${item.id}/`)} eyebrow={`${item.data.stage} · ${item.data.difficulty}`} title={item.data.title} summary={item.data.summary} tags={item.data.skills} />)}</div></section></BaseLayout>
