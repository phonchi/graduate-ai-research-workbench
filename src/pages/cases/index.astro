---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const tools = await getCollection('tools', ({ data }) => !data.draft);
const toolTitles = new Map(tools.map((tool) => [tool.id, tool.data.title]));
---
<BaseLayout title="研究案例">
  <header class="page-header"><div><span class="section-kicker">RESEARCH IN PRACTICE</span><h1>從研究與教學成果學做法</h1><p>看看研究寫作、互動教材、簡報與網站如何完成，再把適合的做法用到自己的工作。</p></div></header>
  <section class="page-band">
    <h2 class="sr-only">研究工作案例</h2>
    <div class="card-grid three">
      {items.map((item) => <CollectionCard href={buildSitePath(base, `/cases/${item.id}/`)} eyebrow={`${item.data.category} · ${item.data.reproducible ? '可重跑' : '流程紀錄'}`} title={item.data.title} summary={item.data.summary} tags={item.data.relatedTools.slice(0, 3).map((tool) => toolTitles.get(tool) ?? tool)} />)}
    </div>
  </section>
</BaseLayout>
