---
import { ArrowRight, BookOpen, ChartNoAxesCombined, Code2, FilePenLine, MonitorUp, Presentation } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const tasks = [
  { id: 'read', title: '我要讀很多 PDF 與資料', description: '先做 quick notes 與索引；來源固定時可用 NotebookLM 問答。', lesson: '03-context-and-indexes', tool: 'notebooklm', icon: BookOpen },
  { id: 'write', title: '我要修改論文或報告', description: '先交代讀者、範圍與不可改動之處，再要求另一個視角挑錯。', lesson: '02-ask-before-action', tool: 'claude-code', icon: FilePenLine },
  { id: 'code', title: '我要跑程式、分析或實驗', description: '用能讀寫工作區的 Agent；動手前先存 Git checkpoint。', lesson: '04-checkpoints-and-tools', tool: 'codex', icon: Code2 },
  { id: 'slides', title: '我要做 seminar 或口試簡報', description: '把內容規格、範例與檢查尺寸說清楚，再用實際輸出驗收。', lesson: '02-ask-before-action', case: 'programmatic-slides', icon: Presentation },
  { id: 'site', title: '我要做研究或實驗室網站', description: '先在副本完成、測試與截圖，確認後才 commit、push 與部署。', lesson: '04-checkpoints-and-tools', case: 'course-site-pages', icon: MonitorUp },
  { id: 'automate', title: '我要把重複流程固定下來', description: '已經跑順的工作寫成 Skill；大量搜尋或獨立審查才考慮 subagent。', lesson: '06-build-your-toolbox', tool: 'skill', icon: ChartNoAxesCombined },
];
---

<BaseLayout title="研究任務" description="從手上的論文、程式、簡報或網站任務，快速找到適合的概念與工具。">
  <header class="page-header"><div><span class="section-kicker">START FROM YOUR WORK</span><h1>你現在卡在哪一種研究工作？</h1><p>這裡只負責帶路，不把同一套內容再講一次。</p></div></header>
  <section class="page-band"><div class="task-detail-list practical-task-list">{tasks.map((task, index) => <article id={task.id}><span class="task-number">{String(index + 1).padStart(2, '0')}</span><task.icon aria-hidden="true" /><div><h2>{task.title}</h2><p>{task.description}</p></div><div class="task-links"><a href={buildSitePath(base, `/learn/${task.lesson}/`)}>先看合作習慣 <ArrowRight size={16} aria-hidden="true" /></a>{task.tool && <a href={buildSitePath(base, `/tools/${task.tool}/`)}>查工具名詞 <ArrowRight size={16} aria-hidden="true" /></a>}{task.case && <a href={buildSitePath(base, `/cases/${task.case}/`)}>看真實案例 <ArrowRight size={16} aria-hidden="true" /></a>}</div></article>)}</div></section>
</BaseLayout>
