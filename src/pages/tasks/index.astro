---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSitePath } from '../../lib/site';
import { skillCategories, legacySkillCategories } from '../../data/skill-categories';
const guidePath = buildSitePath(import.meta.env.BASE_URL, '/guides/research-skills/');
---
<BaseLayout title="前往技能搜尋" noindex pagefindBody={false}>
  <article class="single-article prose">
    <h1>到這裡找研究技能</h1>
    <p>研究任務已整合到<a href={guidePath}>技能搜尋頁</a>。你可以直接搜尋工作內容，或從下面的分類開始。</p>
    <ul>{skillCategories.map((category) => <li><a href={`${guidePath}#${category.id}`}>{category.label}</a></li>)}</ul>
  </article>
</BaseLayout>
<script is:inline define:vars={{ guidePath, legacySkillCategories }}>
  const target = new URL(guidePath, window.location.origin);
  target.search = window.location.search;
  const fragment = window.location.hash.slice(1);
  target.hash = legacySkillCategories[fragment] || fragment;
  window.location.replace(target.href);
</script>
