---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="學習路徑" description="七個研究技能單元，從任務規格一路走到可驗證的自動化。">
  <header class="page-header"><div><span class="section-kicker">LEARNING PATH</span><h1>研究技能學習路徑</h1><p>不預設程式背景。每一站都要產出一份可檢查的研究工作物。</p></div></header>
  <section class="page-band"><ol class="lesson-list">{items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><CollectionCard href={buildSitePath(base, `/learn/${item.id}/`)} eyebrow={`${item.data.stage} · ${item.data.difficulty}`} title={item.data.title} summary={item.data.summary} meta={`${item.data.estimatedMinutes ?? 25} 分鐘`} tags={item.data.skills} /></li>)}</ol></section>
</BaseLayout>
