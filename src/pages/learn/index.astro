---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="概念與習慣" description="沿著投影片主線，從 Chat 與 Agent 的差別一路走到可重複使用的工具箱。">
  <header class="page-header"><div><span class="section-kicker">AGENT HABITS</span><h1>六站學會和 Agent 合作</h1><p>不預設程式背景。每站只處理一個真實卡點，並告訴你工具裡的正式名稱。</p></div></header>
  <section class="page-band"><h2 class="sr-only">六篇核心課程</h2><ol class="lesson-list">{items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><CollectionCard href={buildSitePath(base, `/learn/${item.id}/`)} eyebrow={`${item.data.part} · ${item.data.difficulty}`} title={item.data.title} summary={item.data.summary} meta={`${item.data.estimatedMinutes} 分鐘 · 投影片 ${item.data.slideRefs.join('、')}`} tags={item.data.keyTerms.slice(0, 3)} /></li>)}</ol></section>
</BaseLayout>
