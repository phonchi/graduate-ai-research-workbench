---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="概念與習慣" description="沿著核心學習路徑，從 Agent 心智模型走到可重現研究與工作流評估。">
  <header class="page-header">
    <div><span class="section-kicker">CORE LEARNING PATH</span><h1>七站建立可驗證的 Agent 合作習慣</h1><p>不預設程式背景。每站處理一個研究工作卡點，並把概念、工具名詞與可驗收做法接起來。</p></div>
  </header>
  <section class="page-band">
    <h2 class="sr-only">七篇核心課程</h2>
    <ol class="lesson-list">
      {items.map((item, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <CollectionCard
            href={buildSitePath(base, `/learn/${item.id}/`)}
            eyebrow={`${item.data.part} · ${item.data.difficulty}`}
            title={item.data.title}
            summary={`學完可以：${item.data.learningOutcomes[0]}`}
            meta={`${item.data.estimatedMinutes} 分鐘`}
            tags={item.data.keyTerms.slice(0, 3)}
          />
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
