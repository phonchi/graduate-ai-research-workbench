---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, Clock3, Presentation } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSitePath } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('lessons', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const tools = await getCollection('tools', ({ data }) => !data.draft);
const toolTitles = new Map(tools.map((tool) => [tool.id, tool.data.title]));
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="article-shell">
    <aside class="article-context"><a class="back-link" href={buildSitePath(base, '/learn/')}><ArrowLeft size={16} aria-hidden="true" />概念與習慣</a><div class="context-label">這頁會用到</div><ul>{entry.data.keyTerms.map((term) => <li>{term}</li>)}</ul>{entry.data.relatedTools.length > 0 && <><div class="context-label">工具詞典</div><ul>{entry.data.relatedTools.map((tool) => <li><a href={buildSitePath(base, `/tools/${tool}/`)}>{toolTitles.get(tool) ?? tool}</a></li>)}</ul></>}</aside>
    <article class="lesson-article" data-pagefind-body>
      <header class="article-header"><span class="section-kicker">{entry.data.part} · {entry.data.difficulty}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1><p>{entry.data.summary}</p><div class="article-meta"><span><Clock3 size={16} aria-hidden="true" />{entry.data.estimatedMinutes} 分鐘</span><span><Presentation size={16} aria-hidden="true" />對照投影片 {entry.data.slideRefs.join('、')}</span></div></header>
      <div class="prose"><Content /></div>
    </article>
    <aside class="toc" aria-label="頁內目錄"><strong>本頁內容</strong><ol>{headings.filter((h) => h.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>
  </div>
</BaseLayout>
