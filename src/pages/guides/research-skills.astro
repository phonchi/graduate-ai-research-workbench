---
import { getCollection } from 'astro:content';
import { markdownToHtml } from 'satteri';
import { rehypeAccessibleTaskLists } from '../../lib/rehypeAccessibleTaskLists';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSitePath } from '../../lib/site';
import { normalizeSearch } from '../../lib/research-skills';
import { skillCategories } from '../../data/skill-categories';
const base = import.meta.env.BASE_URL;
const entries = (await getCollection('researchSkills', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const items = await Promise.all(entries.map(async (entry) => ({ entry, html: (await markdownToHtml(entry.body ?? '', { hastPlugins: [rehypeAccessibleTaskLists()] })).html })));
---

<BaseLayout title="找研究技能" description="搜尋讀論文、寫作、做簡報、跑實驗與交接會用到的 AI 技能，找到適合的工具，再展開看用法。" pagefindBody={false}>
  <header class="page-header"><div>
    <span class="section-kicker">RESEARCH SKILLS</span>
    <h1>找研究技能</h1>
    <p>讀論文、修改文章、做簡報，或把進度交給下一次對話：從你現在要做的工作找起。</p>
  </div></header>
  <section class="page-band skill-catalog" data-skill-catalog data-pagefind-body>
    <h2 class="sr-only" data-pagefind-meta="title">研究技能選用指南</h2>
    <p>第一次使用時，先展開卡片，依「原始專案與安裝說明」完成設定。若是 Skill，請讓 Agent 確認已載入，再把交辦範例換成自己的材料。</p>
    <p>工作要交給哪個模型？<a href={`${buildSitePath(base, '/learn/03-context-and-indexes/')}#model-delegation`}>拆解工作、分配算力：高階模型決策、次階模型實作</a>，附上可直接使用的分工範本。</p>
    <form class="skill-search" role="search" aria-label="搜尋技能" onsubmit="return false">
      <div><label for="skill-query">想找什麼技能？</label><input id="skill-query" name="q" type="search" placeholder="例如：交接、論文、簡報、NotebookLM" /></div>
      <div><label for="skill-category">依任務篩選</label><select id="skill-category" name="category"><option value="">全部任務</option>{skillCategories.map((category) => <option value={category.id}>{category.label}</option>)}</select></div>
      <button type="button" class="button secondary" data-clear-skills>清除搜尋</button>
    </form>
    <p class="no-js-skill-note">下方列出所有技能，可展開閱讀用法；啟用 JavaScript 後可搜尋與篩選。</p>
    <nav class="skill-categories" aria-label="技能分類">{skillCategories.map((category) => <a id={category.id} href={`#${category.id}`} data-category-link={category.id}>{category.label}</a>)}</nav>
    <p class="skill-count" role="status" aria-live="polite" data-skill-count>共 {items.length} 項技能與工具</p>
    <div class="skill-grid">
      {items.map(({ entry, html }) => <article class="skill-card" id={`skill-${entry.id}`} data-skill-card data-categories={entry.data.categories.join('|')} data-search={normalizeSearch([entry.data.title, entry.data.summary, ...entry.data.aliases, ...entry.data.tags, ...entry.data.platforms, ...entry.data.categories.map((id) => skillCategories.find((category) => category.id === id)?.label ?? id)].join(' '))}>
        <div class="card-topline"><span>{entry.data.kind}</span><span>{entry.data.categories.map((id) => skillCategories.find((category) => category.id === id)?.label).join('・')}</span></div>
        <h2>{entry.data.title}</h2>
        <p>{entry.data.summary}</p>
        <details><summary>查看 {entry.data.title} 用法</summary><div class="prose skill-body">
          <div set:html={html} />
          {entry.data.platforms.length > 0 && <p><strong>適用環境：</strong>{entry.data.platforms.join('、')}</p>}
          <p><a href={entry.data.sourceUrl}>原始專案與安裝說明</a> · <a href={`#skill-${entry.id}`}>這項技能的連結</a></p>
        </div></details>
      </article>)}
    </div>
    <div class="empty-state" data-no-skills hidden><strong>沒有找到符合條件的技能</strong><p>試試較短的關鍵字，或清除分類再找一次。</p><button class="button secondary" type="button" data-clear-skills>顯示全部技能</button></div>
    <p>想知道 Skill、Hook 或 MCP 是什麼？到<a href={buildSitePath(base, '/tools/')}>工具詞典</a>看說明。要學會怎麼交辦與檢查成果，可以從<a href={buildSitePath(base, '/learn/')}>七篇入門課程</a>開始。</p>
  </section>
</BaseLayout>

<script>
  import { matchesSkill } from '../../lib/research-skills';
  import { legacySkillCategories } from '../../data/skill-categories';
  const root = document.querySelector<HTMLElement>('[data-skill-catalog]');
  if (root) {
    const query = root.querySelector<HTMLInputElement>('#skill-query')!;
    const category = root.querySelector<HTMLSelectElement>('#skill-category')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-skill-card]'));
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-category-link]'));
    const validCategories = new Set(Array.from(category.options).map((option) => option.value));
    const count = root.querySelector<HTMLElement>('[data-skill-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-no-skills]')!;
    const apply = (writeURL = false) => {
      let visible = 0;
      for (const card of cards) {
        card.hidden = !matchesSkill(card.dataset.search ?? '', (card.dataset.categories ?? '').split('|'), query.value, category.value);
        if (!card.hidden) visible += 1;
      }
      count.textContent = `顯示 ${visible} 項技能與工具`;
      empty.hidden = visible > 0;
      for (const link of links) {
        if (link.dataset.categoryLink === category.value) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
      if (writeURL) {
        const url = new URL(window.location.href);
        if (query.value.trim()) url.searchParams.set('q', query.value.trim()); else url.searchParams.delete('q');
        if (category.value) url.searchParams.set('category', category.value); else url.searchParams.delete('category');
        url.hash = '';
        history.replaceState(null, '', url);
      }
    };
    const readURL = () => {
      const url = new URL(window.location.href);
      let fragment = '';
      try { fragment = decodeURIComponent(url.hash.slice(1)); } catch { /* Ignore malformed fragments. */ }
      query.value = url.searchParams.get('q') ?? '';
      const requested = url.searchParams.get('category') ?? legacySkillCategories[fragment] ?? fragment;
      category.value = validCategories.has(requested) ? requested : '';
      const target = document.getElementById(fragment);
      if (target && root.contains(target)) {
        const card = target.closest<HTMLElement>('[data-skill-card]');
        if (card) {
          query.value = '';
          category.value = '';
          const details = card.querySelector('details');
          if (details) details.open = true;
        }
      }
      apply();
      if (target) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    };
    query.addEventListener('input', () => apply(true));
    category.addEventListener('change', () => apply(true));
    root.querySelectorAll('[data-clear-skills]').forEach((button) => button.addEventListener('click', () => {
      query.value = ''; category.value = ''; apply(true); query.focus();
    }));
    links.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      category.value = link.dataset.categoryLink ?? '';
      apply(true);
    }));
    window.addEventListener('hashchange', readURL);
    window.addEventListener('popstate', readURL);
    readURL();
  }
</script>

<style>
  .skill-search { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: 16px; align-items: end; padding: 22px; background: var(--surface-soft); border: 1px solid var(--line); }
  .skill-search label { display: block; margin-bottom: 8px; font-weight: 700; }
  .skill-search input, .skill-search select { width: 100%; min-height: 46px; padding: 10px; background: white; color: var(--ink); border: 1px solid #aab7b0; border-radius: 4px; font: inherit; }
  .skill-categories { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0; }
  .skill-categories a { padding: 8px 12px; border: 1px solid var(--line); border-radius: 5px; text-decoration: none; scroll-margin-top: 100px; }
  .skill-categories a[aria-current] { background: var(--teal); color: white; }
  .skill-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .skill-card { padding: 24px; background: white; border: 1px solid var(--line); border-radius: 6px; min-width: 0; scroll-margin-top: 100px; }
  .skill-card h2 { font-size: 1.4rem; margin: 14px 0 8px; overflow-wrap: anywhere; }
  .skill-card > p { color: var(--muted); }
  .skill-card summary { cursor: pointer; padding: 12px 0; color: var(--teal-dark); font-weight: 700; }
  .skill-body :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .skill-body :global(h3) { font-size: 1.08rem; }
  .skill-body :global(a) { overflow-wrap: anywhere; }
  .skill-catalog [hidden] { display: none !important; }
  :global(.js) .no-js-skill-note { display: none; }
  :global(.no-js) .skill-search { display: none; }
  @media (max-width: 760px) { .skill-grid, .skill-search { grid-template-columns: 1fr; } }
</style>
