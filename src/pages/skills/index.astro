---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { buildSitePath } from '../../lib/site';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('skills', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="技能索引"><header class="page-header"><div><span class="section-kicker">SKILL INDEX</span><h1>研究技能索引</h1><p>快速查清楚一個能力何時使用、最低驗收標準，以及下一步要接哪個單元。</p></div></header><section class="page-band"><div class="card-grid three">{items.map((item) => <CollectionCard href={buildSitePath(base, `/skills/${item.id}/`)} eyebrow={`${item.data.stage} · ${item.data.difficulty}`} title={item.data.title} summary={item.data.summary} tags={item.data.aliases} />)}</div></section></BaseLayout>
