---
import { Search } from 'lucide-astro';
import { buildSitePath } from '../lib/site';
interface Props { destination?: string; label?: string; placeholder?: string; }
const { destination = '/search/', label = '搜尋全站教材', placeholder = '搜尋課程、工具與案例…' } = Astro.props;
const action = buildSitePath(import.meta.env.BASE_URL, destination);
---

<form class="hero-search" action={action} role="search">
  <Search size={22} aria-hidden="true" />
  <label class="sr-only" for="home-search">{label}</label>
  <input id="home-search" type="search" name="q" placeholder={placeholder} aria-label={label} />
  <button type="submit">搜尋</button>
</form>
